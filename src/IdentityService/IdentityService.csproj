    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="..\BurgerIAM.Protos\identity.proto" GrpcServices="Server" />
    <Protobuf Include="..\BurgerIAM.Protos\common.proto" GrpcServices="Server" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
