<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="..\BurgerIAM.Protos\identity.proto" GrpcServices="Client" />
    <Protobuf Include="..\BurgerIAM.Protos\menu.proto" GrpcServices="Client" />
    <Protobuf Include="..\BurgerIAM.Protos\order.proto" GrpcServices="Client" />
    <Protobuf Include="..\BurgerIAM.Protos\payment.proto" GrpcServices="Client" />
    <Protobuf Include="..\BurgerIAM.Protos\kitchen.proto" GrpcServices="Client" />
    <Protobuf Include="..\BurgerIAM.Protos\delivery.proto" GrpcServices="Client" />
    <Protobuf Include="..\BurgerIAM.Protos\feedback.proto" GrpcServices="Client" />
    <Protobuf Include="..\BurgerIAM.Protos\notification.proto" GrpcServices="Client" />
    <Protobuf Include="..\BurgerIAM.Protos\common.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.64.0" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.64.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BurgerIAM.Shared\BurgerIAM.Shared.csproj" />
    <ProjectReference Include="..\BurgerIAM.EventBus\BurgerIAM.EventBus.csproj" />
  </ItemGroup>

</Project>
