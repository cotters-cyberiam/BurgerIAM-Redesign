<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-4">
    <div class="container">
        <a class="navbar-brand" href="/">BurgerIAM</a>
        <button class="navbar-toggler" type="button" @onclick="ToggleNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="@(collapseNavMenu ? "collapse" : "") navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                <li class="nav-item">
                    <a class="nav-link" href="/menu">Menu</a>
                </li>
                @if (Auth.IsLoggedIn)
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/my-orders">My Orders</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cart">
                            Cart @(Cart.TotalItems > 0 ? $"({Cart.TotalItems})" : "")
                        </a>
                    </li>
                }
            </ul>
            <ul class="navbar-nav">
                @if (Auth.IsLoggedIn)
                {
                    <li class="nav-item">
                        <span class="nav-link text-light">@Auth.UserName</span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="" @onclick="Logout">Logout</a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/login">Login</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/register">Register</a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>

@code {
    [Inject] private Services.AuthService Auth { get; set; } = null!;
    [Inject] private Services.CartService Cart { get; set; } = null!;
    [Inject] private NavigationManager Nav { get; set; } = null!;

    private bool collapseNavMenu = true;

    private void ToggleNav()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/");
    }
}
