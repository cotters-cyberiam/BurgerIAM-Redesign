<div class="sidebar-header">
    <a class="sidebar-brand" href="/">BurgerIAM</a>
</div>
<div class="sidebar-nav flex-grow-1 d-flex flex-column">
    <ul class="nav flex-column">
        <li class="nav-item">
            <a class="nav-link" href="/menu">Menu</a>
        </li>
        @if (Auth.IsLoggedIn)
        {
            <li class="nav-item">
                <a class="nav-link" href="/my-orders">My Orders</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/cart">
                    Cart @(Cart.TotalItems > 0 ? $"({Cart.TotalItems})" : "")
                </a>
            </li>
        }
    </ul>
    <hr class="my-2 mx-3 text-white-50" />
    <ul class="nav flex-column">
        @if (Auth.IsLoggedIn)
        {
            <li class="nav-item">
                <span class="nav-link text-white-50 small">@Auth.UserName</span>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="" @onclick="Logout">Logout</a>
            </li>
        }
        else
        {
            <li class="nav-item">
                <a class="nav-link" href="/login">Login</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/register">Register</a>
            </li>
        }
    </ul>
</div>

@code {
    [Inject] private Services.AuthService Auth { get; set; } = null!;
    [Inject] private Services.CartService Cart { get; set; } = null!;
    [Inject] private NavigationManager Nav { get; set; } = null!;

    private async Task Logout()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/");
    }
}