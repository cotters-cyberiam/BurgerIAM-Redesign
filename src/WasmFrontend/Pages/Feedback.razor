@page "/feedback/{OrderId}"
@attribute [Authorize]

<PageTitle>Feedback - BurgerIAM</PageTitle>

<div class="container mt-4">

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger animate-slide-up">@error</div>
    }

    @if (submitted)
    {
        <div class="text-center py-5 animate-on-scroll">
            <div class="display-1 mb-3">🎉</div>
            <h3 class="fw-bold">Thank You!</h3>
            <p class="text-muted">Your feedback has been submitted.</p>
            <a href="/my-orders" class="btn btn-primary btn-lg">Back to Orders</a>
        </div>
    }
    else if (existingFeedback is not null)
    {
        <h2 class="mb-4 fw-bold animate-on-scroll">Your Feedback</h2>
        <div class="alert alert-info animate-slide-up">
            You have already submitted feedback for this order.
        </div>
        <div class="card border-0 shadow-sm animate-on-scroll">
            <div class="card-body">
                <h5 class="fw-bold mb-2">Your Rating</h5>
                <div class="fs-2 mb-2" style="color: #f1c40f;">
                    @(new string('\u2605', existingFeedback.Rating) + new string('\u2606', 5 - existingFeedback.Rating))
                </div>
                @if (!string.IsNullOrEmpty(existingFeedback.Comment))
                {
                    <p class="mb-0">@existingFeedback.Comment</p>
                }
            </div>
        </div>
        <div class="mt-3">
            <a href="/my-orders" class="btn btn-primary">Back to Orders</a>
        </div>
    }
    else
    {
        <h2 class="mb-4 fw-bold animate-on-scroll">Leave Feedback</h2>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm animate-on-scroll">
                    <div class="card-body">
                        <h5 class="card-title fw-bold mb-3">How was your order?</h5>

                        <div class="text-center mb-4">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <button @onclick="() => rating = i"
                                        class="btn star-btn @(i <= rating ? "btn-warning" : "btn-outline-secondary")"
                                        style="font-size: 2rem;"
                                        type="button">
                                    @(i <= rating ? "\u2605" : "\u2606")
                                </button>
                            }
                        </div>

                        @if (rating > 0)
                        {
                            <div class="text-center mb-3">
                                <span class="badge bg-primary fs-6">
                                    @(rating switch
                                    {
                                        1 => "Poor",
                                        2 => "Fair",
                                        3 => "Good",
                                        4 => "Very Good",
                                        5 => "Excellent",
                                        _ => ""
                                    })
                                </span>
                            </div>
                        }

                        <div class="form-floating mb-3">
                            <InputTextArea @bind-Value="comment" class="form-control" placeholder="Tell us about your experience..." id="comment" rows="3" style="min-height: 100px;" />
                            <label for="comment" class="form-label">Comment (optional)</label>
                        </div>

                        <button @onclick="Submit" class="btn btn-primary w-100 btn-lg" disabled="@(rating == 0 || isSubmitting)">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Submitting...</span>
                            }
                            else
                            {
                                <span>Submit Feedback</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string OrderId { get; set; } = "";

    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private Services.AuthService Auth { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private int rating;
    private string comment = "";
    private string? error;
    private bool isSubmitting;
    private bool submitted;
    private Models.FeedbackDetail? existingFeedback;

    protected override async Task OnInitializedAsync()
    {
        existingFeedback = await Api.GetFeedbackAsync(OrderId);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
        }
    }

    private async Task Submit()
    {
        if (rating == 0) return;
        isSubmitting = true;
        error = await Api.SubmitFeedbackAsync(OrderId, Auth.UserId!, rating, comment);
        submitted = error is null;
        isSubmitting = false;
    }
}
