@page "/my-orders"
@attribute [Authorize]

<PageTitle>My Orders - BurgerIAM</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4">My Orders</h2>

    @if (isLoading)
    {
        <div class="text-center"><div class="spinner-border" role="status"></div></div>
    }
    else if (orders.Count == 0)
    {
        <div class="text-center py-5">
            <h4 class="text-muted">No orders yet</h4>
            <a href="/menu" class="btn btn-primary mt-3">Start Ordering</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in orders)
                    {
                        <tr>
                            <td><code>@order.Id[..8]</code></td>
                            <td>@OrderDate(order.CreatedAt)</td>
                            <td>@order.Items.Count</td>
                            <td>$@order.TotalAmount:F2</td>
                            <td><span class="badge @StatusBadge(order.Status)">@StatusText(order.Status)</span></td>
                            <td>
                                <a href="/order-status/@order.Id" class="btn btn-sm btn-outline-primary">Track</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private Services.AuthService Auth { get; set; } = null!;

    private List<Models.OrderResponse> orders = [];
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        orders = await Api.GetMyOrdersAsync(Auth.UserId!);
        isLoading = false;
    }

    private static string OrderDate(string dateStr) =>
        DateTime.TryParse(dateStr, out var dt) ? dt.ToString("MMM dd, yyyy HH:mm") : dateStr;

    private static string StatusText(int status) => status switch
    {
        0 => "Pending",
        1 => "Confirmed",
        2 => "Paid",
        3 => "Preparing",
        4 => "Ready",
        5 => "Out for Delivery",
        6 => "Delivered",
        7 => "Cancelled",
        8 => "Refunded",
        _ => "Unknown"
    };

    private static string StatusBadge(int status) => status switch
    {
        0 => "bg-secondary",
        1 => "bg-info",
        2 => "bg-primary",
        3 => "bg-warning text-dark",
        4 => "bg-success",
        5 => "bg-info",
        6 => "bg-success",
        7 => "bg-danger",
        8 => "bg-dark",
        _ => "bg-secondary"
    };
}
