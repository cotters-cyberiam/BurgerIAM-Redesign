@page "/my-orders"
@attribute [Authorize]
@implements IDisposable

<PageTitle>My Orders - BurgerIAM</PageTitle>

<div class="container mt-4">
    <h2 class="section-title animate-on-scroll">My Orders</h2>
    <p class="section-subtitle animate-on-scroll">Track all your orders in one place</p>

    @if (isLoading)
    {
        <div class="card">
            <div class="card-body">
                @for (int i = 0; i < 4; i++)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="skeleton skeleton-text" style="width:80px;"></div>
                        <div class="skeleton skeleton-text" style="width:140px;"></div>
                        <div class="skeleton skeleton-text" style="width:60px;"></div>
                        <div class="skeleton skeleton-text short"></div>
                        <div class="skeleton skeleton-button" style="width:80px;"></div>
                    </div>
                }
            </div>
        </div>
    }
    else if (orders.Count == 0)
    {
        <div class="text-center py-5 animate-on-scroll">
            <div style="font-size:4rem;margin-bottom:16px;">📋</div>
            <h4 style="color:var(--text-secondary);margin-bottom:8px;">No orders yet</h4>
            <p style="color:var(--text-secondary);">Browse our menu and place your first order!</p>
            <a href="/menu" class="btn btn-primary btn-lg mt-3">Start Ordering</a>
        </div>
    }
    else
    {
        <div class="row mb-4 animate-on-scroll">
            <div class="col-md-4 mb-2">
                <div class="stat-card">
                    <div class="stat-icon">📋</div>
                    <div class="stat-title">@orders.Count</div>
                    <p class="stat-desc">Total Orders</p>
                </div>
            </div>
            <div class="col-md-4 mb-2">
                <div class="stat-card">
                    <div class="stat-icon">📅</div>
                    <div class="stat-title">@LastOrderDate()</div>
                    <p class="stat-desc">Last Order</p>
                </div>
            </div>
            <div class="col-md-4 mb-2">
                <div class="stat-card">
                    <div class="stat-icon">💰</div>
                    <div class="stat-title">£@TotalSpent().ToString("F2")</div>
                    <p class="stat-desc">Total Spent</p>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <h5 class="card-section-title">📋 Order History</h5>

                @foreach (var order in orders)
                {
                    <div class="order-card">
                        <div class="d-flex justify-content-between align-items-start mb-2 flex-wrap gap-2">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <code class="order-card-id">#@Truncate(order.Id, 8)</code>
                                <span class="order-card-date">@OrderDate(order.CreatedAt)</span>
                            </div>
                            <span class="badge @StatusBadge(order.Status)">@StatusText(order.Status)</span>
                        </div>

                        <p class="mb-1 detail-row">
                            <span class="detail-label">Items:</span>
                            <span class="detail-value">@order.Items.Count item(s)</span>
                        </p>
                        <p class="mb-1 detail-row">
                            <span class="detail-label">Total:</span>
                            <span class="detail-value fw-bold" style="color:var(--primary)">£@order.TotalAmount.ToString("F2")</span>
                        </p>

                        <div class="d-flex gap-2 mt-3">
                            <a href="/order-status/@order.Id" class="btn btn-primary btn-sm">Track Order</a>
                            @if (order.Status >= 4)
                            {
                                <a href="/delivery/@order.Id" class="btn btn-outline btn-sm">Delivery</a>
                            }
                            <a href="/receipt/@order.Id" class="btn btn-outline btn-sm">Receipt</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private Services.AuthService Auth { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private List<Models.OrderResponse> orders = [];
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        orders = await Api.GetMyOrdersAsync(Auth.UserId!);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
    }

    private static string Truncate(string value, int maxLength) =>
        value?.Length > maxLength ? value[..maxLength] : value ?? "";

    private static string OrderDate(string dateStr) =>
        DateTime.TryParse(dateStr, out var dt) ? dt.ToString("MMM dd, yyyy HH:mm") : dateStr;

    private string LastOrderDate() =>
        orders.Count > 0 ? OrderDate(orders.MaxBy(o => o.CreatedAt)!.CreatedAt) : "-";

    private double TotalSpent() =>
        orders.Sum(o => o.TotalAmount);

    private static string StatusText(int status) => status switch
    {
        0 => "Pending", 1 => "Confirmed", 2 => "Paid", 3 => "Preparing",
        4 => "Ready", 5 => "Out for Delivery", 6 => "Delivered",
        7 => "Cancelled", 8 => "Refunded", _ => "Unknown"
    };

    private static string StatusBadge(int status) => status switch
    {
        0 => "badge-secondary", 1 => "badge-info", 2 => "badge-primary",
        3 => "badge-warning", 4 => "badge-success", 5 => "badge-info",
        6 => "badge-success", 7 => "badge-danger", 8 => "badge-dark", _ => "badge-secondary"
    };

    public void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("window.BurgerIAM.closeMobileNav"); } catch { }
    }
}
