@page "/order-status/{OrderId}"
@attribute [Authorize]

<PageTitle>Order Status - BurgerIAM</PageTitle>

<div class="container mt-4">

    @if (isLoading)
    {
        <h2 class="mb-4 skeleton skeleton-title" style="width:200px;">&nbsp;</h2>
        <div class="card">
            <div class="card-body">
                <div class="skeleton skeleton-text"></div>
                <div class="skeleton skeleton-text short"></div>
                <div class="skeleton skeleton-text"></div>
                <div class="skeleton skeleton-text short"></div>
            </div>
        </div>
    }
    else if (order is null)
    {
        <div class="text-center py-5 animate-on-scroll">
            <div style="font-size:4rem;margin-bottom:16px;">&#x1F50D;</div>
            <h4 style="color:var(--text-muted);">Order not found</h4>
            <a href="/my-orders" class="btn btn-primary mt-3">View My Orders</a>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 animate-on-scroll">
            <div>
                <h2 class="fw-bold" style="margin:0;letter-spacing:-0.5px;">Order Status</h2>
                <p style="color:var(--text-muted);margin:4px 0 0;font-size:0.9rem;">
                    Order #@Truncate(order.Id, 8) &middot; @OrderDate(order.CreatedAt)
                </p>
            </div>
            <span class="badge @StatusBadge(order.Status)" style="font-size:0.9rem;padding:8px 20px;">@StatusText(order.Status)</span>
        </div>

        <div class="card mb-4 animate-on-scroll">
            <div class="card-body" style="padding:32px;">
                <div class="timeline">
                    @foreach (var step in steps)
                    {
                        <div class="timeline-step @(step.Completed ? "completed" : step.Active ? "active" : "")">
                            <div class="timeline-dot">@(step.Completed ? "\u2713" : step.Number)</div>
                            <strong class="timeline-title">@step.Title</strong>
                            <p class="timeline-desc">@step.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="row mb-3 animate-on-scroll">
            <div class="col-md-6 mb-2">
                <a href="/receipt/@OrderId" class="btn btn-outline btn-block">View Receipt</a>
            </div>
            <div class="col-md-6 mb-2">
                <a href="/feedback/@OrderId" class="btn btn-outline btn-block">Leave Feedback</a>
            </div>
        </div>

        @if (delivery is not null)
        {
            <div class="card animate-on-scroll">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h5 class="fw-bold" style="margin:0;">&#x1F69A; Delivery Status</h5>
                        <a href="/delivery/@OrderId" class="btn btn-sm btn-outline">Track Delivery</a>
                    </div>
                    <p class="mb-1" style="font-size:0.9rem;"><strong>Driver:</strong> @delivery.DriverName</p>
                    <p class="mb-1" style="font-size:0.9rem;"><strong>Status:</strong> <span class="badge @StatusBadge(delivery.Status)">@DeliveryStatusText(delivery.Status)</span></p>
                    @if (!string.IsNullOrEmpty(delivery.EstimatedDeliveryTime))
                    {
                        <p class="mb-0" style="font-size:0.9rem;"><strong>Estimated:</strong> @delivery.EstimatedDeliveryTime</p>
                    }
                </div>
            </div>
        }

        @if (order.Status < 6)
        {
            <div class="text-center mt-3">
                <div class="spinner-border spinner-border-sm text-danger me-1" role="status"></div>
                <small style="color:var(--text-muted);">Auto-refreshing every 10 seconds...</small>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string OrderId { get; set; } = "";

    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private Models.OrderResponse? order;
    private Models.DeliveryResponse? delivery;
    private bool isLoading = true;

    private record TimelineStep(int Number, string Title, string Description, bool Completed, bool Active);

    private List<TimelineStep> steps => GenerateSteps();

    protected override async Task OnInitializedAsync()
    {
        await LoadOrder();
        isLoading = false;
        if (order is not null && order.Status < 6)
            _ = RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
        }
    }

    private async Task RefreshAsync()
    {
        while (order is not null && order.Status < 6)
        {
            await Task.Delay(10000);
            order = await Api.GetOrderAsync(OrderId);
            if (order is not null && order.Status >= 4)
                delivery = await Api.GetDeliveryAsync(OrderId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadOrder()
    {
        order = await Api.GetOrderAsync(OrderId);
        if (order is not null && order.Status >= 4)
            delivery = await Api.GetDeliveryAsync(OrderId);
    }

    private List<TimelineStep> GenerateSteps()
    {
        var status = order?.Status ?? 0;
        return
        [
            new TimelineStep(1, "Order Placed", "Your order has been received", status >= 0, status == 0),
            new TimelineStep(2, "Payment Confirmed", "Payment has been processed", status >= 2, status == 2),
            new TimelineStep(3, "Preparing", "Your food is being prepared", status >= 3, status == 3),
            new TimelineStep(4, "Ready", "Your order is ready", status >= 4, status == 4),
            new TimelineStep(5, "Out for Delivery", "On the way to you", status >= 5, status == 5),
            new TimelineStep(6, "Delivered", "Enjoy your meal!", status >= 6, status == 6)
        ];
    }

    private static string OrderDate(string dateStr) =>
        DateTime.TryParse(dateStr, out var dt) ? dt.ToString("MMM dd, yyyy HH:mm") : dateStr;

    private static string StatusText(int status) => status switch
    {
        0 => "Pending", 1 => "Confirmed", 2 => "Paid", 3 => "Preparing",
        4 => "Ready", 5 => "Out for Delivery", 6 => "Delivered",
        7 => "Cancelled", 8 => "Refunded", _ => "Unknown"
    };

    private static string StatusBadge(int status) => status switch
    {
        0 => "badge-secondary", 1 => "badge-info", 2 => "badge-primary",
        3 => "badge-warning", 4 => "badge-success", 5 => "badge-info",
        6 => "badge-success", 7 => "badge-danger", _ => "badge-secondary"
    };

    private static string Truncate(string value, int maxLength) =>
        value?.Length > maxLength ? value[..maxLength] : value ?? "";

    private static string DeliveryStatusText(int status) => status switch
    {
        0 => "Unassigned", 1 => "Assigned", 2 => "Picked Up",
        3 => "In Transit", 4 => "Delivered", 5 => "Failed", _ => "Unknown"
    };
}
