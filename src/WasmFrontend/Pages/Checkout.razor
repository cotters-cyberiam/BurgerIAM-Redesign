@page "/checkout"
@attribute [Authorize]
@implements IDisposable

<PageTitle>Checkout - BurgerIAM</PageTitle>

@if (orderCreated)
{
    <div class="container mt-4">
        <div class="text-center py-5 animate-on-scroll">
            <div style="font-size:4rem;margin-bottom:16px;">&#x1F389;</div>
            <h3 class="fw-bold">Order Placed Successfully!</h3>
            <p style="color:var(--text-muted);">Order ID: <code class="fw-bold">@TruncateId(orderId)</code></p>
            <p class="fs-5">Your total: <strong class="fs-4" style="color:var(--primary);">&pound;@savedTotal.ToString("F2")</strong></p>
            <div class="mt-4">
                <a href="/order-status/@orderId" class="btn btn-primary btn-lg me-2">Track Order</a>
                <a href="/menu" class="btn btn-outline btn-lg">Order More</a>
            </div>
        </div>
    </div>
}
else if (Cart.IsEmpty)
{
    <div class="container mt-4">
        <div class="text-center py-5 animate-on-scroll">
            <div style="font-size:4rem;margin-bottom:16px;">&#x1F6D2;</div>
            <h4 style="color:var(--text-muted);">Your cart is empty</h4>
            <a href="/menu" class="btn btn-primary btn-lg mt-3">Browse Menu</a>
        </div>
    </div>
}
else
{
    <div class="container mt-4">
        <h2 class="section-title animate-on-scroll">Checkout</h2>
        <p class="section-subtitle animate-on-scroll">Complete your order</p>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="toast error" style="margin-bottom:16px;animation:none;">
                <span>&#x274C;</span>
                <span>@error</span>
            </div>
        }

        <div class="row">
            <div class="col-md-7">
                <div class="card mb-3 animate-on-scroll">
                    <div class="card-body">
                        <h5 style="font-weight:700;margin-bottom:16px;">&#x1F4CD; Delivery Address</h5>
                        <div class="form-float">
                            <InputText @bind-Value="deliveryAddress" placeholder=" " id="address" />
                            <label for="address">Address</label>
                        </div>
                    </div>
                </div>

                <div class="card animate-on-scroll">
                    <div class="card-body">
                        <h5 style="font-weight:700;margin-bottom:16px;">&#x1F4B3; Payment</h5>
                        <div class="form-float mb-3">
                            <InputText @bind-Value="cardNumber" placeholder=" " id="card" />
                            <label for="card">Card Number</label>
                        </div>
                        <div class="row">
                            <div class="col">
                                <div class="form-float">
                                    <InputText @bind-Value="expiry" placeholder=" " id="expiry" />
                                    <label for="expiry">Expiry</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-float">
                                    <InputText @bind-Value="cvv" placeholder=" " id="cvv" />
                                    <label for="cvv">CVV</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card animate-on-scroll" style="position:sticky;top:80px;">
                    <div class="card-body">
                        <h5 style="font-weight:700;margin-bottom:16px;">&#x1F4CB; Order Summary</h5>
                        @foreach (var item in Cart.Items)
                        {
                            <div style="display:flex;justify-content:space-between;margin-bottom:8px;font-size:0.9rem;">
                                <span>@item.ItemName <span style="color:var(--text-muted);">x@item.Quantity</span></span>
                                <span class="fw-medium">&pound;@((item.UnitPrice * item.Quantity).ToString("F2"))</span>
                            </div>
                        }
                        <hr style="border-color:var(--border-subtle);" />
                        <div style="display:flex;justify-content:space-between;margin-bottom:4px;color:var(--text-secondary);font-size:0.9rem;">
                            <span>Subtotal</span>
                            <span>&pound;@Cart.TotalAmount.ToString("F2")</span>
                        </div>
                        <div style="display:flex;justify-content:space-between;margin-bottom:4px;color:var(--text-secondary);font-size:0.9rem;">
                            <span>Delivery</span>
                            <span style="color:#2ecc71;">Free</span>
                        </div>
                        <hr style="border-color:var(--border-subtle);" />
                        <div style="display:flex;justify-content:space-between;margin-bottom:16px;">
                            <strong style="font-size:1.1rem;">Total</strong>
                            <strong style="font-size:1.1rem;color:var(--primary);">&pound;@Cart.TotalAmount.ToString("F2")</strong>
                        </div>
                        <button @onclick="PlaceOrder" class="btn btn-primary btn-block btn-lg" disabled="@isProcessing">
                            @if (isProcessing)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                                <span>Processing...</span>
                            }
                            else
                            {
                                <span>Place Order</span>
                            }
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Inject] private Services.CartService Cart { get; set; } = null!;
    [Inject] private Services.AuthService Auth { get; set; } = null!;
    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private NavigationManager Nav { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private string deliveryAddress = "";
    private string cardNumber = "";
    private string expiry = "";
    private string cvv = "";
    private string? error;
    private bool isProcessing;
    private bool orderCreated;
    private string? orderId;
    private double savedTotal;

    protected override void OnInitialized()
    {
        if (!Auth.IsLoggedIn)
            Nav.NavigateTo("/login");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
    }

    private async Task PlaceOrder()
    {
        if (string.IsNullOrWhiteSpace(deliveryAddress))
        {
            error = "Please enter a delivery address";
            return;
        }

        isProcessing = true;
        error = null;

        try
        {
            var items = Cart.Items.Select(i => new Models.OrderItemRequest(i.MenuItemId, i.ItemName, i.Quantity, i.UnitPrice)).ToList();
            var capturedTotal = items.Sum(i => i.Quantity * i.UnitPrice);
            var request = new Models.CreateOrderRequest(Auth.UserId!, Auth.UserEmail!, items, deliveryAddress);

            var order = await Api.CreateOrderAsync(request);
            if (order is null)
            {
                error = "Failed to place order. Please try again.";
                isProcessing = false;
                return;
            }

            orderId = order.Id;
            savedTotal = capturedTotal > 0 ? capturedTotal : order.TotalAmount > 0 ? order.TotalAmount : Cart.TotalAmount;
            Cart.Clear();
            await JS.InvokeVoidAsync("window.BurgerIAM.animateCartBadge", 0);
            orderCreated = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

        isProcessing = false;
    }

    private static string TruncateId(string? id) =>
        !string.IsNullOrEmpty(id) && id.Length > 8 ? id[..8] : id ?? "";

    public void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("window.BurgerIAM.closeMobileNav"); } catch { }
    }
}
