@page "/register"
@attribute [AllowAnonymous]

<PageTitle>Register - BurgerIAM</PageTitle>

<div class="container">
    <div class="row justify-content-center" style="padding-top:80px;">
        <div class="col-md-6 col-lg-4">
            <div class="card animate-on-scroll">
                <div class="card-body" style="padding:32px;">
                    <div class="text-center mb-4">
                        <div style="font-size:2.5rem;margin-bottom:8px;">&#x1F44B;</div>
                        <h3 class="fw-bold">Create Account</h3>
                        <p style="color:var(--text-muted);">Join BurgerIAM today</p>
                    </div>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="toast error" style="margin-bottom:16px;animation:none;border-left-color:var(--primary);">
                            <span>&#x274C;</span>
                            <span>@error</span>
                        </div>
                    }
                    @if (success)
                    {
                        <div class="toast success" style="margin-bottom:16px;animation:none;">
                            <span>&#x2705;</span>
                            <span>Account created! <a href="/login" class="fw-bold" style="color:inherit;">Sign in now</a></span>
                        </div>
                    }

                    <div class="form-float">
                        <InputText @bind-Value="name" placeholder=" " id="regName" />
                        <label for="regName">Name</label>
                    </div>
                    <div class="form-float">
                        <InputText @bind-Value="email" placeholder=" " id="regEmail" />
                        <label for="regEmail">Email</label>
                    </div>
                    <div class="form-float">
                        <InputText @bind-Value="password" type="password" placeholder=" " id="regPassword" />
                        <label for="regPassword">Password</label>
                    </div>
                    <button @onclick="HandleRegister" class="btn btn-primary btn-block btn-lg" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Creating...</span>
                        }
                        else
                        {
                            <span>Create Account</span>
                        }
                    </button>

                    <div class="text-center mt-4">
                        <p class="mb-0" style="color:var(--text-muted);">Already have an account? <a href="/login" class="fw-bold" style="color:var(--primary);">Sign in</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private Services.AuthService Auth { get; set; } = null!;
    [Inject] private NavigationManager Nav { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private string name = "";
    private string email = "";
    private string password = "";
    private string? error;
    private bool isLoading;
    private bool success;

    protected override void OnInitialized()
    {
        if (Auth.IsLoggedIn)
            Nav.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
    }

    private async Task HandleRegister()
    {
        isLoading = true;
        error = null;

        if (string.IsNullOrWhiteSpace(name) || string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "All fields are required";
            isLoading = false;
            return;
        }

        try
        {
            error = await Auth.Register(email, password, name);
        }
        catch (Exception ex)
        {
            error = $"Connection error: {ex.Message}";
        }

        if (error is null)
        {
            success = true;
            isLoading = false;
            await Task.Delay(1500);
            Nav.NavigateTo("/login");
        }
        else
        {
            isLoading = false;
        }
    }
}
