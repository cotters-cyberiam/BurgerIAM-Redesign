@page "/menu"
@attribute [AllowAnonymous]
@implements IDisposable

<PageTitle>Menu - BurgerIAM</PageTitle>

<div class="container mt-4">
    <h2 class="section-title animate-on-scroll">Our Menu</h2>
    <p class="section-subtitle animate-on-scroll">Freshly prepared, delivered fast</p>

    @if (isLoading)
    {
        <div class="row">
            @for (int i = 0; i < 6; i++)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="skeleton skeleton-image"></div>
                            <div class="skeleton skeleton-title mt-2"></div>
                            <div class="skeleton skeleton-text"></div>
                            <div class="skeleton skeleton-text short"></div>
                            <div class="skeleton skeleton-button mt-2"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="category-pills mb-4 animate-on-scroll">
            <button class="category-pill @(selectedCategory == null ? "active" : "")" @onclick="() => SelectCategory(null)">All</button>
            @foreach (var cat in categories)
            {
                <button class="category-pill @(selectedCategory == cat ? "active" : "")" @onclick="() => SelectCategory(cat)">@cat</button>
            }
        </div>

        @foreach (var category in groupedItems)
        {
            <h4 class="mt-4 mb-3 animate-on-scroll" style="color:var(--primary);font-weight:700;">
                @category.Key
            </h4>
            <div class="row">
                @foreach (var item in category)
                {
                    <div class="col-md-6 col-lg-4 mb-3 animate-on-scroll">
                        <div class="menu-card h-100 @(item.IsAvailable ? "" : "opacity-50")">
                            <div class="menu-card-img">
                                <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:3rem;">
                                    &#x1F354;
                                </div>
                            </div>
                            <div class="menu-card-body">
                                <h5 class="menu-card-name">@item.Name</h5>
                                <p class="menu-card-desc">@item.Description</p>
                                <div class="menu-card-footer">
                                    <span class="menu-card-price">&pound;@item.Price.ToString("F2")</span>
                                    @if (item.IsAvailable)
                                    {
                                        <button @onclick="() => AddToCart(item)" class="btn btn-primary btn-sm">
                                            Add to Cart
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge badge-secondary">Unavailable</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (!groupedItems.Any())
        {
            <div class="text-center py-5">
                <h4 style="color:var(--text-muted);">No menu items available</h4>
            </div>
        }
    }
</div>

@code {
    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private Services.CartService Cart { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private List<Models.MenuItemResponse> items = [];
    private bool isLoading = true;
    private string? selectedCategory;

    private List<string> categories => items
        .Where(i => !string.IsNullOrEmpty(i.Category))
        .Select(i => i.Category!)
        .Distinct()
        .ToList();

    private ILookup<string, Models.MenuItemResponse> groupedItems =>
        items
            .Where(i => !string.IsNullOrEmpty(i.Category))
            .Where(i => selectedCategory == null || i.Category == selectedCategory)
            .ToLookup(i => i.Category!);

    protected override async Task OnInitializedAsync()
    {
        items = await Api.GetMenuAsync();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
    }

    private void SelectCategory(string? cat)
    {
        selectedCategory = cat;
        StateHasChanged();
    }

    private async void AddToCart(Models.MenuItemResponse item)
    {
        Cart.AddItem(new Models.CartItem(item.Id, item.Name, item.Price, 1));
        await JS.InvokeVoidAsync("window.BurgerIAM.animateCartBadge", Cart.TotalItems);
        await JS.InvokeVoidAsync("window.BurgerIAM.showToast", $"{item.Name} added to cart!", "success");
    }

    public void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("window.BurgerIAM.closeMobileNav"); } catch { }
    }
}
