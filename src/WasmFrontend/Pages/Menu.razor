@page "/menu"
@attribute [AllowAnonymous]
@implements IDisposable

<PageTitle>Menu - BurgerIAM</PageTitle>

<div class="container mt-4">
    <h2 class="mb-4 fw-bold animate-on-scroll">Our Menu</h2>

    @if (isLoading)
    {
        <div class="row">
            @for (int i = 0; i < 6; i++)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="skeleton skeleton-title"></div>
                            <div class="skeleton skeleton-text"></div>
                            <div class="skeleton skeleton-text short"></div>
                            <div class="skeleton skeleton-button mt-2"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        @foreach (var category in groupedItems)
        {
            <h4 class="mt-4 mb-3 animate-on-scroll" style="color: var(--primary); font-weight: 700;">
                @category.Key
            </h4>
            <div class="row">
                @foreach (var item in category)
                {
                    <div class="col-md-6 col-lg-4 mb-3 animate-on-scroll">
                        <div class="card menu-card h-100 @(item.IsAvailable ? "" : "opacity-50")">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="flex-grow-1 me-2">
                                        <h5 class="card-title mb-1 fw-bold">@item.Name</h5>
                                        <p class="card-text text-muted small mb-0">@item.Description</p>
                                    </div>
                                    <span class="price-tag">&pound;@item.Price.ToString("F2")</span>
                                </div>
                                <div class="mt-auto">
                                    @if (item.IsAvailable)
                                    {
                                        <button @onclick="() => AddToCart(item)" class="btn btn-sm btn-primary">
                                            Add to Cart
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Unavailable</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (!groupedItems.Any())
        {
            <div class="text-center py-5">
                <h4 class="text-muted">No menu items available</h4>
            </div>
        }
    }
</div>

@code {
    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private Services.CartService Cart { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private List<Models.MenuItemResponse> items = [];
    private bool isLoading = true;

    private ILookup<string, Models.MenuItemResponse> groupedItems =>
        items.Where(i => !string.IsNullOrEmpty(i.Category)).ToLookup(i => i.Category);

    protected override async Task OnInitializedAsync()
    {
        items = await Api.GetMenuAsync();
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
        }
    }

    private async void AddToCart(Models.MenuItemResponse item)
    {
        Cart.AddItem(new Models.CartItem(item.Id, item.Name, item.Price, 1));
        await JS.InvokeVoidAsync("window.BurgerIAM.animateCartBadge", Cart.TotalItems);
        await JS.InvokeVoidAsync("window.BurgerIAM.showFloatingMsg", $"{item.Name} added to cart!", "success");
    }

    public void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("window.BurgerIAM.closeMobileNav"); } catch { }
    }
}
