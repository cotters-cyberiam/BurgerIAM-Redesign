@page "/"
@attribute [AllowAnonymous]
@implements IAsyncDisposable

<PageTitle>BurgerIAM - Fast Food Ordering</PageTitle>

<div class="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
        <div class="animate-on-scroll">
            <div class="hero-badge">
                <span>&#x1F525;</span> Fresh & Fast
            </div>
            <h1>Delicious <span class="highlight">Burgers</span>,<br />Delivered Fast</h1>
            <p>Premium fast food made with fresh ingredients. Order online and track in real-time.</p>
            <div class="hero-actions">
                <a href="/menu" class="btn btn-primary btn-lg">View Menu</a>
                @if (!Auth.IsLoggedIn)
                {
                    <a href="/register" class="btn btn-outline btn-lg">Get Started</a>
                }
                else
                {
                    <a href="/my-orders" class="btn btn-outline btn-lg">My Orders</a>
                }
            </div>
            <div class="hero-stats">
                <div class="hero-stat">
                    <div class="hero-stat-value">50+</div>
                    <div class="hero-stat-label">Menu Items</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-value">15min</div>
                    <div class="hero-stat-label">Avg. Delivery</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-value">4.9</div>
                    <div class="hero-stat-label">Customer Rating</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container">
    @if (isLoading)
    {
        <div class="text-center mb-4">
            <div class="skeleton skeleton-title mx-auto" style="width:200px;"></div>
            <div class="skeleton skeleton-text mx-auto" style="width:300px;"></div>
        </div>
        <div class="row">
            @for (int i = 0; i < 3; i++)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card"><div class="skeleton skeleton-card"></div></div>
                </div>
            }
        </div>
    }
    else
    {
        @if (averageRating is not null && averageRating.TotalReviews > 0)
        {
            <div class="text-center mb-5 animate-on-scroll" style="margin-top:48px;">
                <h3 class="fw-bold" style="margin-bottom:12px;">What Our Customers Say</h3>
                <div class="star-rating d-inline-flex" style="gap:6px;">
                    @for (int i = 1; i <= 5; i++)
                    {
                        <span style="font-size:2rem;color:@(i <= (int)Math.Round(averageRating.AverageRating) ? "#f1c40f" : "rgba(255,255,255,0.15)");">&#x2605;</span>
                    }
                </div>
                <p style="color:var(--text-muted);margin-top:8px;">
                    @averageRating.AverageRating.ToString("F1") average rating (@averageRating.TotalReviews reviews)
                </p>
            </div>
        }

        <h3 class="section-title animate-on-scroll" style="margin-top:48px;">Popular Items</h3>
        <p class="section-subtitle animate-on-scroll">Our most loved dishes</p>

        <div class="row">
            @foreach (var item in popularItems)
            {
                <div class="col-md-6 col-lg-4 mb-4 animate-on-scroll">
                    <div class="menu-card h-100">
                        <div class="menu-card-img">
                        @if (item.Category == "Drinks" && _drinkImageMap.TryGetValue(item.Id, out var drinkImg))
                        {
                            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;">
                                <img src="@drinkImg" alt="@item.Name" class="drink-icon" />
                            </div>
                        }
                        else
                        {
                            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:3rem;">
                                &#x1F354;
                            </div>
                        }
                        </div>
                        <div class="menu-card-body">
                            <h5 class="menu-card-name">@item.Name</h5>
                            <p class="menu-card-desc">@Truncate(item.Description, 60)</p>
                            <div class="menu-card-footer">
                                <span class="menu-card-price">&pound;@item.Price.ToString("F2")</span>
                                <a href="/menu" class="btn btn-primary btn-sm">Order Now</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="row mt-5 mb-5">
            <div class="col-md-4 mb-3 animate-on-scroll animate-left">
                <div class="stat-card">
                    <div class="stat-icon">&#x1F354;</div>
                    <h5 class="stat-title">Quality Food</h5>
                    <p class="stat-desc">Fresh ingredients, prepared with care.</p>
                </div>
            </div>
            <div class="col-md-4 mb-3 animate-on-scroll">
                <div class="stat-card">
                    <div class="stat-icon">&#x1F69A;</div>
                    <h5 class="stat-title">Fast Delivery</h5>
                    <p class="stat-desc">Track your order in real-time.</p>
                </div>
            </div>
            <div class="col-md-4 mb-3 animate-on-scroll animate-right">
                <div class="stat-card">
                    <div class="stat-icon">&#x1F4B3;</div>
                    <h5 class="stat-title">Easy Payment</h5>
                    <p class="stat-desc">Secure checkout with multiple options.</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private Services.AuthService Auth { get; set; } = null!;

    private List<Models.MenuItemResponse> popularItems = [];
    private Models.AverageRatingResponse? averageRating;
    private bool isLoading = true;
    private readonly Dictionary<string, string> _drinkImageMap = [];
    private static readonly string[] _drinkImages = ["/images/drink1.png", "/images/drink2.png"];

    protected override async Task OnInitializedAsync()
    {
        var menuTask = Api.GetMenuAsync();
        var ratingTask = Api.GetAverageRatingAsync();
        await Task.WhenAll(menuTask, ratingTask);
        var menu = menuTask.Result;
        popularItems = menu.Where(i => i.IsAvailable).Take(6).ToList();
        averageRating = ratingTask.Result;
        var rng = Random.Shared;
        foreach (var item in menu.Where(i => i.Category == "Drinks"))
        {
            _drinkImageMap[item.Id] = _drinkImages[rng.Next(_drinkImages.Length)];
        }
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
    }

    private static string Truncate(string? value, int max) =>
        !string.IsNullOrEmpty(value) && value.Length > max ? value[..max] + "..." : value ?? "";

    [Inject] private IJSRuntime JS { get; set; } = null!;

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("window.BurgerIAM.closeMobileNav"); } catch { }
    }
}
