@page "/delivery/{OrderId}"
@attribute [Authorize]

<PageTitle>Delivery Tracking - BurgerIAM</PageTitle>

<div class="container mt-4">

    @if (isLoading)
    {
        <h2 class="mb-4 fw-bold skeleton skeleton-title" style="width: 250px;">&nbsp;</h2>
        <div class="row">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body text-center py-5">
                        <div class="skeleton skeleton-avatar mx-auto mb-3"></div>
                        <div class="skeleton skeleton-title mx-auto" style="width: 150px;"></div>
                        <div class="skeleton skeleton-text mx-auto" style="width: 200px;"></div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <div class="skeleton skeleton-title"></div>
                        <div class="skeleton skeleton-text"></div>
                        <div class="skeleton skeleton-text short"></div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (delivery is null)
    {
        <div class="text-center py-5 animate-on-scroll">
            <div class="display-1 mb-3">🔍</div>
            <h4 class="text-muted">Delivery information not available</h4>
            <a href="/order-status/@OrderId" class="btn btn-primary mt-3">Check Order Status</a>
        </div>
    }
    else
    {
        <h2 class="mb-4 fw-bold animate-on-scroll">Delivery Tracking</h2>

        <div class="row">
            <div class="col-md-8">
                <div class="card border-0 shadow-sm mb-4 animate-on-scroll">
                    <div class="card-body text-center py-4">
                        <div class="display-1 mb-3">
                            @((MarkupString)(delivery.Status >= 4 ? "\U0001F389" : delivery.Status >= 3 ? "\U0001F69A" : delivery.Status >= 2 ? "\U0001F4E6" : "\U0001F4C5"))
                        </div>
                        <h4 class="fw-bold @StatusColor(delivery.Status)">@StatusText(delivery.Status)</h4>
                        <p class="text-muted">Order: <code>@OrderId[..Math.Min(8, OrderId.Length)]</code></p>
                    </div>
                </div>

                <div class="card border-0 shadow-sm animate-on-scroll">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Tracking Timeline</h5>
                        <div class="tracking-timeline">
                            <div class="d-flex align-items-center mb-3 p-2 rounded @(delivery.Status >= 0 ? "text-success bg-success bg-opacity-10" : "text-muted")">
                                <span class="me-3 fs-5 fw-bold">@(delivery.Status >= 0 ? "\u2713" : "\u25CB")</span>
                                <div><strong>Order Placed</strong></div>
                            </div>
                            <div class="d-flex align-items-center mb-3 p-2 rounded @(delivery.Status >= 1 ? "text-success bg-success bg-opacity-10" : "text-muted")">
                                <span class="me-3 fs-5 fw-bold">@(delivery.Status >= 1 ? "\u2713" : "\u25CB")</span>
                                <div>
                                    <strong>Driver Assigned</strong>
                                    <small class="d-block text-muted">@delivery.DriverName</small>
                                </div>
                            </div>
                            <div class="d-flex align-items-center mb-3 p-2 rounded @(delivery.Status >= 2 ? "text-success bg-success bg-opacity-10" : "text-muted")">
                                <span class="me-3 fs-5 fw-bold">@(delivery.Status >= 2 ? "\u2713" : "\u25CB")</span>
                                <div><strong>Order Picked Up</strong></div>
                            </div>
                            <div class="d-flex align-items-center mb-3 p-2 rounded @(delivery.Status >= 3 ? "text-success bg-success bg-opacity-10" : "text-muted")">
                                <span class="me-3 fs-5 fw-bold">@(delivery.Status >= 3 ? "\u2713" : "\u25CB")</span>
                                <div><strong>In Transit</strong></div>
                            </div>
                            <div class="d-flex align-items-center p-2 rounded @(delivery.Status >= 4 ? "text-success bg-success bg-opacity-10" : "text-muted")">
                                <span class="me-3 fs-5 fw-bold">@(delivery.Status >= 4 ? "\u2713" : "\u25CB")</span>
                                <div><strong>Delivered</strong></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-0 shadow-sm mb-3 animate-on-scroll">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Driver Details</h5>
                        <p class="mb-1"><strong>Name:</strong> @delivery.DriverName</p>
                        <p class="mb-0"><strong>Status:</strong> <span class="badge @StatusBadge(delivery.Status)">@StatusText(delivery.Status)</span></p>
                    </div>
                </div>

                <div class="card border-0 shadow-sm mb-3 animate-on-scroll">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Delivery Info</h5>
                        <p class="mb-1"><strong>Address:</strong> @delivery.DeliveryAddress</p>
                        @if (!string.IsNullOrEmpty(delivery.EstimatedDeliveryTime))
                        {
                            <p class="mb-1"><strong>Estimated:</strong> @delivery.EstimatedDeliveryTime</p>
                        }
                        @if (!string.IsNullOrEmpty(delivery.CompletedAt))
                        {
                            <p class="mb-0"><strong>Delivered at:</strong> @DeliveryDate(delivery.CompletedAt)</p>
                        }
                    </div>
                </div>

                <div class="d-grid gap-2 animate-on-scroll">
                    <a href="/order-status/@OrderId" class="btn btn-outline-primary">Full Order Status</a>
                    <a href="/receipt/@OrderId" class="btn btn-outline-secondary">View Receipt</a>
                </div>
            </div>
        </div>

        @if (delivery.Status < 4)
        {
            <div class="text-center mt-3">
                <div class="spinner-border spinner-border-sm text-primary me-1" role="status"></div>
                <small class="text-muted">Auto-refreshing every 10 seconds...</small>
            </div>
        }
    }
</div>

@code {
    [Parameter] public string OrderId { get; set; } = "";

    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private Models.DeliveryResponse? delivery;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadDelivery();
        isLoading = false;
        if (delivery is not null && delivery.Status < 4)
            _ = RefreshAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
        }
    }

    private async Task RefreshAsync()
    {
        while (delivery is not null && delivery.Status < 4)
        {
            await Task.Delay(10000);
            delivery = await Api.GetDeliveryAsync(OrderId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadDelivery()
    {
        delivery = await Api.GetDeliveryAsync(OrderId);
    }

    private static string StatusText(int status) => status switch
    {
        0 => "Unassigned", 1 => "Assigned", 2 => "Picked Up",
        3 => "In Transit", 4 => "Delivered", 5 => "Failed", _ => "Unknown"
    };

    private static string StatusColor(int status) => status switch
    {
        0 => "text-secondary", 1 => "text-info", 2 => "text-primary",
        3 => "text-warning", 4 => "text-success", 5 => "text-danger", _ => "text-secondary"
    };

    private static string StatusBadge(int status) => status switch
    {
        0 => "bg-secondary", 1 => "bg-info", 2 => "bg-primary",
        3 => "bg-warning text-dark", 4 => "bg-success", 5 => "bg-danger", _ => "bg-secondary"
    };

    private static string DeliveryDate(string dateStr) =>
        DateTime.TryParse(dateStr, out var dt) ? dt.ToString("MMM dd, yyyy HH:mm") : dateStr;
}
