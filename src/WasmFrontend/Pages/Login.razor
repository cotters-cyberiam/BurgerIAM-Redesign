@page "/login"
@attribute [AllowAnonymous]

<PageTitle>Login - BurgerIAM</PageTitle>

<div class="container">
    <div class="row justify-content-center" style="padding-top:80px;">
        <div class="col-md-6 col-lg-4">
            <div class="card animate-on-scroll">
                <div class="card-body" style="padding:32px;">
                    <div class="text-center mb-4">
                        <div style="font-size:2.5rem;margin-bottom:8px;">&#x1F354;</div>
                        <h3 class="fw-bold">Welcome Back</h3>
                        <p style="color:var(--text-muted);">Sign in to your account</p>
                    </div>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="toast error" style="margin-bottom:16px;animation:none;border-left-color:var(--primary);">
                            <span>&#x274C;</span>
                            <span>@error</span>
                        </div>
                    }

                    <div class="form-float">
                        <InputText @bind-Value="email" placeholder=" " id="loginEmail" />
                        <label for="loginEmail">Email</label>
                    </div>
                    <div class="form-float">
                        <InputText @bind-Value="password" type="password" placeholder=" " id="loginPassword" />
                        <label for="loginPassword">Password</label>
                    </div>
                    <button @onclick="HandleLogin" class="btn btn-primary btn-block btn-lg" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                        }
                    </button>

                    <div class="text-center mt-4">
                        <p class="mb-0" style="color:var(--text-muted);">Don't have an account? <a href="/register" class="fw-bold" style="color:var(--primary);">Register</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private Services.AuthService Auth { get; set; } = null!;
    [Inject] private NavigationManager Nav { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private string email = "";
    private string password = "";
    private string? error;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (Auth.IsLoggedIn)
            Nav.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        error = null;

        var result = await Auth.Login(email, password);
        if (result is not null)
            Nav.NavigateTo("/menu");
        else
            error = "Invalid email or password";

        isLoading = false;
    }
}
