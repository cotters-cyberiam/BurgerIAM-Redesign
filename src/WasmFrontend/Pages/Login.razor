@page "/login"
@attribute [AllowAnonymous]

<PageTitle>Login - BurgerIAM</PageTitle>

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-lg animate-on-scroll">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <img src="images/logo.png" alt="BurgerIAM" height="64" class="mb-2" />
                        <h3 class="fw-bold">Welcome Back</h3>
                        <p class="text-muted">Sign in to your account</p>
                    </div>

                    @if (!string.IsNullOrEmpty(error))
                    {
                        <div class="alert alert-danger animate-slide-up">@error</div>
                    }

                    <div class="form-floating mb-3">
                        <InputText @bind-Value="email" class="form-control" placeholder="your@email.com" id="loginEmail" />
                        <label for="loginEmail" class="form-label">Email</label>
                    </div>
                    <div class="form-floating mb-3">
                        <InputText @bind-Value="password" type="password" class="form-control" placeholder="Password" id="loginPassword" />
                        <label for="loginPassword" class="form-label">Password</label>
                    </div>
                    <button @onclick="HandleLogin" class="btn btn-primary w-100 btn-lg" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>Signing in...</span>
                        }
                        else
                        {
                            <span>Sign In</span>
                        }
                    </button>

                    <div class="text-center mt-4">
                        <p class="mb-0">Don't have an account? <a href="/register" class="fw-bold">Register</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private Services.AuthService Auth { get; set; } = null!;
    [Inject] private NavigationManager Nav { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private string email = "";
    private string password = "";
    private string? error;
    private bool isLoading;

    protected override void OnInitialized()
    {
        if (Auth.IsLoggedIn)
            Nav.NavigateTo("/");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
        }
    }

    private async Task HandleLogin()
    {
        isLoading = true;
        error = null;

        var result = await Auth.Login(email, password);
        if (result is not null)
            Nav.NavigateTo("/menu");
        else
            error = "Invalid email or password";

        isLoading = false;
    }
}
