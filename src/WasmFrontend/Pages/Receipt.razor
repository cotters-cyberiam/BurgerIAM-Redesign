@page "/receipt/{OrderId}"
@attribute [Authorize]

<PageTitle>Receipt - BurgerIAM</PageTitle>

<div class="container mt-4">
    <h2 class="section-title animate-on-scroll">Receipt</h2>
    <p class="section-subtitle animate-on-scroll">Order summary and details</p>

    @if (isLoading)
    {
        <div class="card">
            <div class="card-body p-4">
                <div class="skeleton skeleton-title mx-auto" style="width:200px;"></div>
                <div class="skeleton skeleton-image mt-3"></div>
            </div>
        </div>
    }
    else if (html is not null)
    {
        <div class="card animate-on-scroll">
            <div class="card-body p-0">
                <iframe srcdoc="@html" class="receipt-frame"></iframe>
            </div>
        </div>
        <div class="mt-3 text-center animate-on-scroll">
            <button @onclick="PrintReceipt" class="btn btn-primary btn-lg me-2">&#x1F5A8;&#xFE0F; Print</button>
            <a href="/my-orders" class="btn btn-outline btn-lg">Back to Orders</a>
        </div>
    }
    else
    {
        <div class="text-center py-5 animate-on-scroll">
            <div style="font-size:4rem;margin-bottom:16px;">&#x1F9FE;</div>
            <h4 style="color:var(--text-muted);">Receipt not found</h4>
            <p style="color:var(--text-muted);">Receipt for order @OrderId is not available yet.</p>
            <a href="/my-orders" class="btn btn-primary mt-3">View My Orders</a>
        </div>
    }
</div>

@code {
    [Parameter] public string OrderId { get; set; } = "";

    [Inject] private Services.ApiService Api { get; set; } = null!;
    [Inject] private IJSRuntime JS { get; set; } = null!;

    private string? html;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        html = await Api.GetReceiptHtmlAsync(OrderId);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await JS.InvokeVoidAsync("window.BurgerIAM.observeNewElements");
    }

    private void PrintReceipt() { }
}
